	<version>1.4.1-SNAPSHOT</version>
	<name>CustomItemsLib</name>
	<url>https://github.com/Becerritoo/CustomItemsLib</url>
	<description>Shared infrastructure for signed reward items and consumer plugins.</description>

	<parent>
		<groupId>one.lindegaard</groupId>
		<artifactId>Main</artifactId>
		<version>0.1.6-SNAPSHOT</version>
